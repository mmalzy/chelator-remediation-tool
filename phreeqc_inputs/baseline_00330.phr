TITLE Baseline No Chelator | pH=7.5 Metal=Low Texture=Sand Moisture=Dry Ionic=High CaMg=High
SOLUTION 1
    temp      25
    pH        7.5
    pe        12
    units     mol/L
    Pb        1.206564e-04
    Cu        3.147326e-04
    Zn        4.588559e-04
    Cd        1.779185e-05
    Ca        2.495134e-03
    Mg        2.057190e-03
    Na        8.699435e-02
    Cl        8.461907e-02
    C(4)      8.325701e-04

SURFACE 1
    Hfo_wOH   0.1  600  0.09
    -equil 1

SELECTED_OUTPUT
    -reset       false
    -totals      Pb Cu Zn Cd
    -molalities  Pb+2 Cu+2 Zn+2 Cd+2
                 Hfo_wOPb+ Hfo_wOCu+ Hfo_wOZn+ Hfo_wOCd+

END