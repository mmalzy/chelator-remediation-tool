TITLE Baseline No Chelator | pH=6.5 Metal=High Texture=Sand Moisture=Wet Ionic=Medium CaMg=Low
SOLUTION 1
    temp      25
    pH        6.5
    pe        3
    units     mol/L
    Pb        1.447876e-03
    Cu        3.934158e-03
    Zn        6.118079e-03
    Cd        2.223982e-04
    Ca        4.990269e-04
    Mg        4.114380e-04
    Na        2.174859e-02
    Cl        1.974445e-02
    C(4)      8.325701e-04

SURFACE 1
    Hfo_wOH   0.1  600  0.09
    -equil 1

SELECTED_OUTPUT
    -reset       false
    -totals      Pb Cu Zn Cd
    -molalities  Pb+2 Cu+2 Zn+2 Cd+2
                 Hfo_wOPb+ Hfo_wOCu+ Hfo_wOZn+ Hfo_wOCd+

END