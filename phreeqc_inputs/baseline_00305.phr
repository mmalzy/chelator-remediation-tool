TITLE Baseline No Chelator | pH=6.5 Metal=High Texture=Loam Moisture=Wet Ionic=High CaMg=Low
SOLUTION 1
    temp      25
    pH        6.5
    pe        3
    units     mol/L
    Pb        1.447876e-03
    Cu        3.934158e-03
    Zn        6.118079e-03
    Cd        2.223982e-04
    Ca        4.990269e-04
    Mg        4.114380e-04
    Na        8.699435e-02
    Cl        8.461907e-02
    C(4)      2.081425e-03

SURFACE 1
    Hfo_wOH   0.5  600  0.09
    -equil 1

SELECTED_OUTPUT
    -reset       false
    -totals      Pb Cu Zn Cd
    -molalities  Pb+2 Cu+2 Zn+2 Cd+2
                 Hfo_wOPb+ Hfo_wOCu+ Hfo_wOZn+ Hfo_wOCd+

END