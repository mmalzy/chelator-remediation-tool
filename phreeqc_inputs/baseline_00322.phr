TITLE Baseline No Chelator | pH=6.5 Metal=High Texture=Clay Moisture=Wet Ionic=Medium CaMg=High
SOLUTION 1
    temp      25
    pH        6.5
    pe        3
    units     mol/L
    Pb        1.447876e-03
    Cu        3.934158e-03
    Zn        6.118079e-03
    Cd        2.223982e-04
    Ca        2.495134e-03
    Mg        2.057190e-03
    Na        2.174859e-02
    Cl        1.974445e-02
    C(4)      3.330281e-03

SURFACE 1
    Hfo_wOH   1.5  600  0.09
    -equil 1

SELECTED_OUTPUT
    -reset       false
    -totals      Pb Cu Zn Cd
    -molalities  Pb+2 Cu+2 Zn+2 Cd+2
                 Hfo_wOPb+ Hfo_wOCu+ Hfo_wOZn+ Hfo_wOCd+

END