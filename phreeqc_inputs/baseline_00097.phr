TITLE Baseline No Chelator | pH=5.5 Metal=Medium Texture=Clay Moisture=Mesic Ionic=Low CaMg=Low
SOLUTION 1
    temp      25
    pH        5.5
    pe        8
    units     mol/L
    Pb        4.826255e-04
    Cu        1.258931e-03
    Zn        1.835424e-03
    Cd        7.116741e-05
    Ca        4.990269e-04
    Mg        4.114380e-04
    Na        4.349717e-03
    Cl        4.230954e-03
    C(4)      3.330281e-03

SURFACE 1
    Hfo_wOH   1.5  600  0.09
    -equil 1

SELECTED_OUTPUT
    -reset       false
    -totals      Pb Cu Zn Cd
    -molalities  Pb+2 Cu+2 Zn+2 Cd+2
                 Hfo_wOPb+ Hfo_wOCu+ Hfo_wOZn+ Hfo_wOCd+

END