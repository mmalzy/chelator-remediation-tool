TITLE Baseline No Chelator | pH=6.5 Metal=Medium Texture=Loam Moisture=Mesic Ionic=High CaMg=High
SOLUTION 1
    temp      25
    pH        6.5
    pe        8
    units     mol/L
    Pb        4.826255e-04
    Cu        1.258931e-03
    Zn        1.835424e-03
    Cd        7.116741e-05
    Ca        2.495134e-03
    Mg        2.057190e-03
    Na        8.699435e-02
    Cl        8.461907e-02
    C(4)      2.081425e-03

SURFACE 1
    Hfo_wOH   0.5  600  0.09
    -equil 1

SELECTED_OUTPUT
    -reset       false
    -totals      Pb Cu Zn Cd
    -molalities  Pb+2 Cu+2 Zn+2 Cd+2
                 Hfo_wOPb+ Hfo_wOCu+ Hfo_wOZn+ Hfo_wOCd+

END